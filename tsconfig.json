{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "allowImportingTsExtensions": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "src",
    "tests",
    "wxt.config.ts",
    "vitest.config.ts",
    "eslint.config.js",
    ".wxt/wxt.d.ts"
  ]
}
